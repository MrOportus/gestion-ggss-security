rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para verificar si es Admin (requiere que el documento de Firestore use el UID)
    function isAdmin() {
      return request.auth != null && 
        firestore.get(/databases/(default)/documents/Colaboradores/$(request.auth.uid)).data.role == 'admin';
    }

    // Carpeta de evidencias (fotos de rondas/asistencia)
    match /evidencias/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Documentos Originales (Subidos por Admin)
    match /original_docs/{allPaths=**} {
      allow write: if request.auth != null; // Idealmente restringir a isAdmin() si funciona firestore.get
      allow read: if request.auth != null;
    }

    // Documentos Corporativos (Biblioteca)
    match /company_documents/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Documentos Firmados — INMUTABLES post-firma
    // Solo se permite la subida inicial (create). Una vez firmado, el archivo
    // no puede ser reemplazado (update) ni eliminado (delete) desde el cliente.
    // Las Cloud Functions con Admin SDK no están sujetas a estas reglas.
    match /signed_docs/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Asistencia Photos
    match /attendance/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Préstamos
    match /loans/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Evidencias de Incidencias y Novedades (GG.SS.)
    // El guardia solo puede escribir en su propio UID-folder; admins/supervisors pueden leer todo.
    match /novedades/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }
  }
}
