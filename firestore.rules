rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario es Admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)) &&
        'role' in get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data.role == 'admin';
    }

    // Función auxiliar para verificar si el usuario es Supervisor
    function isSupervisor() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)) &&
        'role' in get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isRRHH() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)) &&
        'role' in get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data.role == 'rrhh';
    }

    function isJefeOperaciones() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)) &&
        'role' in get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data.role == 'jefe_operaciones';
    }

    // Función auxiliar para verificar si el usuario es Mandante
    function isMandante() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Colaboradores/$(request.auth.uid)).data.role == 'mandante';
    }
    
    // Función auxiliar para verificar si el usuario es el dueño del documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Función auxiliar para verificar si el usuario es activo
    function isColaborador() {
      return request.auth != null && exists(/databases/$(database)/documents/Colaboradores/$(request.auth.uid));
    }

    // Reglas para la colección de documentos digitales (Signatures)
    match /documents/{docId} {
      allow create, delete: if isAdmin();

      // Lectura: admin o el dueño del documento (asignado a él)
      allow read: if isAdmin() || (request.auth != null && resource.data.assignedTo == request.auth.uid);

      // Actualización: el admin o el propio trabajador pueden actualizar,
      // PERO ningún cliente puede escribir los campos de integridad (protegidos por backend).
      allow update: if (isAdmin() || (request.auth != null && resource.data.assignedTo == request.auth.uid))
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['validationId', 'integridad']);
    }

    // Auditoría de validaciones de integridad (solo Cloud Functions pueden escribir)
    match /validacionesDocumentos/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Plantillas de firma (SignatureTemplates)
    match /signatureTemplates/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    
    // Documentos Corporativos (Biblioteca)
    match /company_documents/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    
    // Índice para RUTs (Evita duplicados)
    match /RutIndex/{rut} {
      allow read, write: if isAdmin();
    }
    
    // Colaboradores (Fichas de empleado)
    match /Colaboradores/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwner(userId);
    }
    
    // Asistencia
    match /Asistencia/{logId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        (isSupervisor() && exists(/databases/$(database)/documents/AlcancesOperativos/$(request.auth.uid)) && resource.data.siteId in get(/databases/$(database)/documents/AlcancesOperativos/$(request.auth.uid)).data.sucursales) ||
        resource.data.employeeId == request.auth.uid ||
        !isSupervisor() // RRHH and others with auth can read everything for now, except if they are supervisor we restrict them
      );
      // Fase 5B.3: Impedir falsificación de turnoProgramadoId desde cliente
      allow create: if isColaborador() && 
        (isAdmin() || isSupervisor() || request.resource.data.employeeId == request.auth.uid) &&
        (!request.resource.data.keys().hasAny(['turnoProgramadoId']) || isAdmin());
      allow update: if isColaborador() && (isAdmin() || isSupervisor() || 
        (resource.data.employeeId == request.auth.uid && 
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['turnoProgramadoId', 'employeeId', 'siteId', 'shiftId']) || isAdmin())));
      allow delete: if isAdmin() || isSupervisor();
    }
    
    // AttendanceShadowDiagnostics
    match /AttendanceShadowDiagnostics/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Solo backend
    }

    // Asistencia Digital (sincronización con Gestión de Turnos - check_in)
    match /asistencia_digital/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (isAdmin() || isSupervisor() || request.resource.data.employeeId == request.auth.uid);
      allow delete: if request.auth != null;
    }

    // Asistencia Manual (sincronización con Gestión de Turnos - check_out)
    match /asistencia_manual/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (isAdmin() || isSupervisor() || request.resource.data.employeeId == request.auth.uid);
      allow delete: if isAdmin() || isSupervisor();
    }

    // Programación de Turnos (solo admin/supervisor pueden escribir en campos no operacionales)
    match /programacion/{docId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow delete: if isAdmin() || isSupervisor();
      allow update: if (isAdmin() || isSupervisor()) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fecha', 'horario', 'turno', 'estado', 'siteId', 'colaboradorId']));
    }

    
    // Rondas (GuardRounds)
    match /Rondas/{roundId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        isSupervisor() || 
        isMandante() ||
        resource.data.workerId == request.auth.uid
      );
      allow create: if request.auth != null && (isAdmin() || isSupervisor() || request.resource.data.workerId == request.auth.uid);
      allow update: if request.auth != null && (isAdmin() || isSupervisor() || resource.data.workerId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // SupervisorTasks, ChecklistTemplates, RecurringTasks, etc.
    match /SupervisorTasks/{taskId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.supervisorId == request.auth.uid);
      allow create: if isAdmin() || isSupervisor();
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.supervisorId == request.auth.uid);
    }

    match /SupervisorSubTasks/{taskId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.supervisorId == request.auth.uid);
      allow create: if isAdmin() || isSupervisor();
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.supervisorId == request.auth.uid);
    }

    match /RecurringSupervisorTasks/{taskId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.supervisorId == request.auth.uid);
      allow create: if isAdmin() || isSupervisor();
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.supervisorId == request.auth.uid);
    }
    
    match /BoardNotes/{noteId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    match /reminders/{reminderId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }
    
    match /ChecklistTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Sucursales, Anticipos, Prestamos, TurnosDiarios, Notas
    match /Sucursales/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /Anticipos/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSupervisor();
    }

    match /Prestamos/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSupervisor();
    }

    match /TurnosDiarios/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSupervisor();
    }

    match /notas_turnos/{docId} {
      allow read, write: if request.auth != null;
    }

    match /HistoricoContratos/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSupervisor();
    }

    match /Vacaciones/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSupervisor();
    }

    match /ConflictWarnings/{docId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow create, delete: if false; // Solo backend
    }

    match /solicitudes_turnos/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.estado == 'disponible' &&
        request.resource.data.estado == 'asignado' &&
        request.resource.data.id_colaborador_asignado == request.auth.uid
      );
    }
    
    match /TurnosProgramados/{id} {
      allow read: if request.auth != null;
      allow create: if false;
      allow delete: if isAdmin() || isSupervisor();
      allow update: if (isAdmin() || isSupervisor()) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fechaOperacional', 'horarioSnapshot', 'codigoTurno', 'estado', 'sucursalId', 'colaboradorId']));
    }
    
    match /Contratos/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /AsignacionesOperacionales/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSupervisor();
    }
    
    match /ResignationRequests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isSupervisor();
    }

    // 🔒 Feature Flags del Shadow Resolver (Phase 5) — solo lectura puntual desde cliente
    // El documento app_config/feature_flags puede ser leído (get) por cualquier usuario autenticado.
    // No se permite listado, creación, edición ni borrado desde el cliente.
    // El Admin SDK (backend) opera sin restricciones de Rules.
    match /app_config/feature_flags {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 📱 Configuración de la App (versión del APK para auto-actualización, etc.)
    // Se permite get individual pero NO list de la colección completa.
    match /app_config/{docId} {
      allow get: if request.auth != null && docId != 'feature_flags';
      allow list: if false;
      allow create, update, delete: if isAdmin() && docId != 'feature_flags';
    }

    match /ProgramacionLocks/{lockId} {
      allow read, create, update, delete: if false;
    }

    match /OperationTokens/{tokenId} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // 🔒 COLECCIONES V2 — BACKEND-ONLY (Phase 5D.2)
    //
    // Ningún cliente puede leer, listar, crear, modificar ni eliminar
    // documentos de estas colecciones directamente.
    //
    // El acceso legítimo ocurre ÚNICAMENTE a través de:
    //   - Admin SDK (Cloud Functions backend)
    //   - Callable getAttendanceShadowValidated (que usa Admin SDK internamente)
    //
    // Confundir "lectura via Callable" con "lectura directa" es un error de
    // arquitectura. Las Rules Emulator deben confirmar que ningún cliente
    // autenticado puede realizar un get/list directo.
    // ═══════════════════════════════════════════════════════════════════════

    // AsistenciasConsolidadas (V2 read model — backend-only)
    match /AsistenciasConsolidadas/{docId} {
      allow read:   if false; // Ningún cliente — solo Admin SDK
      allow write:  if false; // Ningún cliente — solo Admin SDK
      allow list:   if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // AttendanceShadowComparisons (resultado de shadow read — backend-only)
    match /AttendanceShadowComparisons/{docId} {
      allow read:   if false;
      allow write:  if false;
      allow list:   if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // AuditoriaAcciones (registro de auditoría — backend-only)
    match /AuditoriaAcciones/{docId} {
      allow read:   if false;
      allow write:  if false;
      allow list:   if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // FeatureFlags — attendanceV2Read solo puede ser leído por backend
    // El cliente NO debe leer este flag directamente; la Callable lo evalúa internamente.
    // FeatureFlags
    match /FeatureFlags/contractEligibilityV2 {
      allow get: if request.auth != null
        && (
          isAdmin()
          || isRRHH()
          || isJefeOperaciones()
          || isSupervisor()
        );

      allow list: if false;
      allow create, update, delete: if false;
    }

    match /FeatureFlags/{docId} {
      allow read:   if false;
      allow write:  if false;
      allow list:   if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ContractShadowDiagnostics
    match /ContractShadowDiagnostics/{diagnosticId} {
      allow read, write: if false;
    }

    // AttendanceShadowDiagnostics (diagnósticos — admin read only via Callable)
    match /AttendanceShadowDiagnostics/{docId} {
      allow read:  if false; // Previamente isAdmin(), ahora solo Admin SDK
      allow write: if false;
    }

    // AlcancesOperativos (scope operativo — solo backend)
    match /AlcancesOperativos/{docId} {
      allow read:  if false; // Solo Admin SDK (validado en Callable)
      allow write: if false;
    }





    // ─── Incidencias y Novedades (Libro de Novedades — GG.SS.) ──────────────
    // Colección `novedades` — compartida por guardias de la misma sucursal.
    // Lectura: cualquier colaborador autenticado (la restricción por sucursal
    //          se hace vía query cliente: where('sucursalId', '==', miSucursal))
    // Creación: solo el propio guardia, con su UID validado
    // Edición:  solo Admin/Supervisor (para cambiar estado)
    // Borrado:  nunca — trazabilidad absoluta
    match /novedades/{docId} {
      allow read: if request.auth != null && isColaborador();
      allow create: if request.auth != null &&
        isColaborador() &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.colaboradorId == request.auth.uid;
      allow update: if isAdmin() || isSupervisor();
      allow delete: if false;
    }



    // Reglas por defecto para cualquier otra colección (Denegación estricta)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
